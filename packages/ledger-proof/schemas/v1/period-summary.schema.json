{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vt-infinite:marrs-rover:schema:period-summary:1",
  "title": "Marrs Rover period summary, version 1",
  "description": "Cash activity for one entity and period, per currency, with restricted-fund roll-forwards (PRD MR-17 to MR-19). For each currency: closing = opening + receipts - disbursements + reversalsNet + transfers. Different currencies are never added together.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "marrs-rover.period-summary.1"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "demoLabel": {
      "$ref": "#/$defs/demoLabel"
    },
    "entityId": {
      "$ref": "#/$defs/slug"
    },
    "periodId": {
      "$ref": "#/$defs/periodId"
    },
    "basis": {
      "const": "cash"
    },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "currency": {
            "$ref": "#/$defs/currency"
          },
          "opening": {
            "$ref": "#/$defs/signedInt"
          },
          "receipts": {
            "type": "object",
            "properties": {
              "operating": {
                "$ref": "#/$defs/nonNegInt"
              },
              "financing": {
                "$ref": "#/$defs/nonNegInt"
              }
            },
            "required": [
              "operating",
              "financing"
            ],
            "additionalProperties": false
          },
          "disbursements": {
            "type": "object",
            "properties": {
              "operating": {
                "$ref": "#/$defs/nonNegInt"
              },
              "financing": {
                "$ref": "#/$defs/nonNegInt"
              }
            },
            "required": [
              "operating",
              "financing"
            ],
            "additionalProperties": false
          },
          "reversalsNet": {
            "$ref": "#/$defs/signedInt"
          },
          "transfers": {
            "type": "object",
            "properties": {
              "internalNet": {
                "$ref": "#/$defs/signedInt"
              },
              "boundaryNet": {
                "$ref": "#/$defs/signedInt"
              }
            },
            "required": [
              "internalNet",
              "boundaryNet"
            ],
            "additionalProperties": false
          },
          "closing": {
            "$ref": "#/$defs/signedInt"
          }
        },
        "required": [
          "currency",
          "opening",
          "receipts",
          "disbursements",
          "reversalsNet",
          "transfers",
          "closing"
        ],
        "additionalProperties": false
      }
    },
    "buckets": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "bucketId": {
            "$ref": "#/$defs/slug"
          },
          "currency": {
            "$ref": "#/$defs/currency"
          },
          "opening": {
            "$ref": "#/$defs/signedInt"
          },
          "closing": {
            "$ref": "#/$defs/signedInt"
          }
        },
        "required": [
          "bucketId",
          "currency",
          "opening",
          "closing"
        ],
        "additionalProperties": false
      }
    },
    "restrictedFunds": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "restrictionId": {
            "$ref": "#/$defs/slug"
          },
          "currency": {
            "$ref": "#/$defs/currency"
          },
          "opening": {
            "$ref": "#/$defs/signedInt"
          },
          "receipts": {
            "$ref": "#/$defs/nonNegInt"
          },
          "disbursements": {
            "$ref": "#/$defs/nonNegInt"
          },
          "reversalsNet": {
            "$ref": "#/$defs/signedInt"
          },
          "closing": {
            "$ref": "#/$defs/signedInt"
          }
        },
        "required": [
          "restrictionId",
          "currency",
          "opening",
          "receipts",
          "disbursements",
          "reversalsNet",
          "closing"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "events": {
          "$ref": "#/$defs/nonNegInt"
        },
        "financialEvents": {
          "$ref": "#/$defs/nonNegInt"
        },
        "receipt": {
          "$ref": "#/$defs/nonNegInt"
        },
        "disbursement": {
          "$ref": "#/$defs/nonNegInt"
        },
        "transfer": {
          "$ref": "#/$defs/nonNegInt"
        },
        "reversal": {
          "$ref": "#/$defs/nonNegInt"
        },
        "reclassification": {
          "$ref": "#/$defs/nonNegInt"
        },
        "reconciliation": {
          "$ref": "#/$defs/nonNegInt"
        },
        "attestation": {
          "$ref": "#/$defs/nonNegInt"
        }
      },
      "required": [
        "events",
        "financialEvents",
        "receipt",
        "disbursement",
        "transfer",
        "reversal",
        "reclassification",
        "reconciliation",
        "attestation"
      ],
      "additionalProperties": false
    },
    "statement": {
      "$ref": "#/$defs/text"
    }
  },
  "required": [
    "schema",
    "environment",
    "entityId",
    "periodId",
    "basis",
    "currencies",
    "buckets",
    "restrictedFunds",
    "counts",
    "statement"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "synthetic-demo"
          }
        },
        "required": [
          "environment"
        ]
      },
      "then": {
        "required": [
          "demoLabel"
        ]
      },
      "else": {
        "properties": {
          "demoLabel": false
        }
      }
    }
  ],
  "$defs": {
    "environment": {
      "enum": [
        "synthetic-demo",
        "local-prototype",
        "devnet",
        "mainnet-pilot"
      ]
    },
    "demoLabel": {
      "const": "Demo data — not VT Infinite's financial records."
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "posInt": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,29}$"
    },
    "nonNegInt": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,29})$"
    },
    "signedInt": {
      "type": "string",
      "pattern": "^(?:0|-?[1-9][0-9]{0,29})$"
    },
    "signedNonZero": {
      "type": "string",
      "pattern": "^-?[1-9][0-9]{0,29}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "periodId": {
      "type": "string",
      "pattern": "^[0-9]{4}-Q[1-4]$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/slug"
      }
    }
  }
}
