{
  "name": "vt-infinite",
  "version": "0.1.0",
  "private": true,
  "description": "vt-infinite.com, rebuilt from an empty repository.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-release.mjs",
    "build": "next build",
    "build:noproxy": "SITE_MODE=landing VT_TEST_BUILD_WITHOUT_PROXY=1 npm run build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "guard": "node scripts/guard.mjs",
    "secrets": "secretlint --maskSecrets \"**/*\"",
    "ledger": "node scripts/ledger-release-check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run guard && npm run secrets && npm run ledger && npm run build && npm run build:noproxy && npm run test:e2e",
    "prepare": "husky",
    "refresh": "node scripts/refresh.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "canonicalize": "5.1.0",
    "fast-xml-parser": "5.11.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "husky": "9.1.7",
    "secretlint": "13.0.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
