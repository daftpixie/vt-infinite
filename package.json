{
  "name": "vt-infinite",
  "version": "0.1.0",
  "private": true,
  "description": "vt-infinite.com, rebuilt from an empty repository.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "guard": "node scripts/guard.mjs",
    "secrets": "secretlint --maskSecrets \"**/*\"",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run guard && npm run secrets && npm run build && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "husky": "9.1.7",
    "secretlint": "13.0.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
